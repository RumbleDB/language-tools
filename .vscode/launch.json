{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Launch VSCode Extension",
            "type": "node",
            "request": "attach",
            "address": "127.0.0.1",
            "port": 9333,
            "continueOnAttach": true,
            "outFiles": ["${workspaceFolder}/packages/vscode-extension/dist/**/*.js"],
            "preLaunchTask": "launch:extension-host",
            "trace": {
                "logFile": "${workspaceFolder}/.vscode/extension-host-debug.log"
            }
        },
        {
            "name": "Attach to Language Server",
            "type": "node",
            "request": "attach",
            "port": 6009,
            "restart": true,
            "outFiles": ["${workspaceFolder}/packages/language-server/dist/**/*.js"]
        }
    ]
}
