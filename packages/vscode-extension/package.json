{
    "name": "jsoniq-vscode",
    "displayName": "JSONiq and XQuery Language Support",
    "version": "1.6.0",
    "private": true,
    "description": "Rich language support for JSONiq and XQuery, featuring syntax highlighting, code completion, and diagnostics powered by RumbleDB.",
    "categories": [
        "Programming Languages"
    ],
    "license": "Apache-2.0",
    "repository": {
        "url": "https://github.com/RumbleDB/language-tools",
        "directory": "packages/vscode-extension"
    },
    "publisher": "RumbleDB",
    "main": "./dist/extension.js",
    "scripts": {
        "build": "pnpm run clean && pnpm run build:webview && pnpm run typecheck && pnpm run bundle",
        "build:prod": "pnpm run clean && pnpm run build:webview && pnpm run typecheck && pnpm run bundle:prod",
        "build:webview": "pnpm --filter @jsoniq/results-ui run build",
        "watch:webview": "pnpm --filter @jsoniq/results-ui run build:watch",
        "typecheck": "tsc -p tsconfig.json --noEmit",
        "watch:typecheck": "tsc -p tsconfig.json --noEmit -w",
        "bundle": "rolldown -c",
        "bundle:prod": "rolldown -c --environment BUILD:production",
        "watch:bundle": "rolldown -c -w",
        "watch": "run-p watch:webview watch:typecheck watch:bundle",
        "clean": "rm -rf dist",
        "lint": "oxlint",
        "lint:fix": "oxlint --fix",
        "fmt": "oxfmt",
        "fmt:check": "oxfmt --check"
    },
    "dependencies": {
        "jsoniq-language-server": "workspace:*",
        "vscode-languageclient": "^10.1.0"
    },
    "devDependencies": {
        "@types/node": "^26.1.2",
        "@types/vscode": "^1.120.0",
        "oxfmt": "catalog:",
        "oxlint": "catalog:",
        "rolldown": "1.2.1",
        "typescript": "^7.0.2"
    },
    "contributes": {
        "languages": [
            {
                "id": "jsoniq",
                "aliases": [
                    "JSONiq"
                ],
                "extensions": [
                    ".jq",
                    ".jsoniq",
                    ".jqm"
                ],
                "configuration": "./language-configuration.json"
            },
            {
                "id": "xquery",
                "aliases": [
                    "XQuery"
                ],
                "extensions": [
                    ".xq",
                    ".xqy",
                    ".xquery",
                    ".xqm"
                ],
                "configuration": "./language-configuration.json"
            }
        ],
        "grammars": [
            {
                "language": "jsoniq",
                "scopeName": "source.jsoniq",
                "path": "./syntaxes/jsoniq.tmLanguage.json"
            },
            {
                "language": "xquery",
                "scopeName": "source.xquery",
                "path": "./syntaxes/xquery.tmLanguage.json"
            },
            {
                "scopeName": "source.jsoniq-notebook-injection",
                "path": "./syntaxes/jsoniq-notebook-injection.tmLanguage.json",
                "injectTo": [
                    "source.python"
                ],
                "embeddedLanguages": {
                    "meta.embedded.block.jsoniq": "jsoniq"
                }
            }
        ],
        "configurationDefaults": {
            "[jsoniq]": {
                "editor.wordBasedSuggestions": "off",
                "editor.suggest.showWords": false
            },
            "[xquery]": {
                "editor.wordBasedSuggestions": "off",
                "editor.suggest.showWords": false
            }
        },
        "commands": [
            {
                "command": "jsoniq.runQuery",
                "title": "Execute Query",
                "category": "JSONiq",
                "icon": "$(play)"
            }
        ],
        "menus": {
            "editor/title": [
                {
                    "command": "jsoniq.runQuery",
                    "group": "navigation",
                    "when": "editorLangId == jsoniq || editorLangId == xquery"
                }
            ],
            "editor/context": [
                {
                    "command": "jsoniq.runQuery",
                    "group": "1_modification",
                    "when": "editorLangId == jsoniq || editorLangId == xquery"
                }
            ]
        },
        "configuration": {
            "title": "JSONiq Language Support Configuration",
            "properties": {
                "jsoniq.lsp.wrapper.enabled": {
                    "type": "boolean",
                    "default": true,
                    "description": "Enable enhanced LSP features powered by the RumbleDB Java wrapper (requires Java 17+ to be installed)."
                }
            }
        }
    },
    "activationEvents": [
        "onNotebook:jupyter-notebook"
    ],
    "icon": "assets/icon.png",
    "engines": {
        "vscode": "^1.120.0"
    }
}
